# Planet Generator configuration. Copy to .env.local to override.
#
# Vite exposes only VITE_-prefixed variables to the browser, and everything
# it exposes is public — readable by anyone who opens the page. Nothing
# here may ever hold a credential.

# debug | info | warn | error | silent
# Default: debug in development, warn in a build. Anything else falls back
# to the default with a warning.
VITE_LOG_LEVEL=
